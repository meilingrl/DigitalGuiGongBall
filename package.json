{
  "name": "digital-guigong-ball",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "dev:api": "tsx watch server/index.ts",
    "build:api": "tsc -p tsconfig.server.json",
    "build:all": "npm run build && npm run build:api",
    "start": "node dist-server/server/index.js",
    "db:init": "tsx server/cli.ts init",
    "db:seed": "tsx server/cli.ts seed",
    "test:api": "tsx --test server/tests/*.test.ts",
    "test:restart": "node scripts/verify-restart.mjs",
    "test": "tsx --test server/tests/*.test.ts tests/*.test.ts",
    "typecheck": "vue-tsc -b && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@vueuse/core": "^14.2.1",
    "express": "^5.3.0",
    "pinia": "^3.0.4",
    "three": "^0.183.2",
    "vue": "^3.5.30",
    "vue-router": "^5.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/tsconfig": "^0.9.0",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
