# Browser-side AMap credentials. Values bundled by Vite are visible to users.
# Use a Web JS key restricted to the exact development/deployment domains.
VITE_AMAP_KEY=

# Plaintext securityJsCode is acceptable only for local/course demos.
# For production, follow AMap's proxy-service guidance instead of shipping it in the browser bundle.
VITE_AMAP_SECURITY_CODE=
