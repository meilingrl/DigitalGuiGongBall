# Node >=22.13; no external account or key required.
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/guigong.sqlite
# Comma-separated exact origins. Include the browser URL, without trailing slash.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
SESSION_TTL_HOURS=168
# Set true when serving through HTTPS. Local HTTP development uses false.
SECURE_COOKIES=false
